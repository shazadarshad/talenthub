# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# A long, random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Which config to load: development, production, or testing
FLASK_ENV=development

# Database connection string.
# Leave unset locally to use SQLite automatically.
# In production (e.g. Render), this is provided automatically when you
# attach a PostgreSQL database - it looks like:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# OpenAI API key, used for AI CV summaries and smart candidate search.
# Get one at https://platform.openai.com/api-keys
# If left blank, AI features are simply disabled - the rest of the app
# still works normally.
OPENAI_API_KEY=

# SMTP settings for sending password reset emails.
# Works with Gmail (use an "App Password", not your normal password),
# SendGrid, Mailgun, or any standard SMTP provider.
# If MAIL_USERNAME is left blank, reset links are just printed to the
# server logs instead of emailed - useful for local development.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
